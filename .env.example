# Copy to .env for local dev (`vercel dev`), and add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit the real .env — it is in .gitignore.

# 1) Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-...

# 2) Supabase project URL (Supabase → Project Settings → API → Project URL)
#    Passwordless Auth uses this same project. No extra Auth secret is needed;
#    the browser uses the public anon key already documented in public/config.js.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# 3) Supabase SERVICE ROLE key (same page → "service_role" secret).
#    Server-only. Bypasses row-level security. Never put this in public/config.js.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 4) Passphrase that unlocks the "Run synthesis" button (you choose it).
#    Without this, anyone who finds /api/synthesize could spend your Anthropic credits.
ADMIN_KEY=choose-a-long-random-passphrase

# 5) The crew password shown on the landing page. Everyone on the crew types this to get in.
#    Use a long passphrase (4+ random words). Changing it logs everyone out.
#    If this is missing, the whole site stays locked.
SITE_PASSWORD=choose-a-different-long-passphrase
