{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": {
    "api/summarize.js": { "maxDuration": 30 },
    "api/map-pillars.js": { "maxDuration": 30 },
    "api/google-doc.js": { "maxDuration": 30 },
    "api/metrics.js": { "maxDuration": 10 },
    "api/suggested-pillars.js": { "maxDuration": 10 },
    "api/test-persona-submit.js": { "maxDuration": 10 },
    "api/synthesize.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
